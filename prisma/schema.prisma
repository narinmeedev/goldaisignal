datasource db {
  provider  = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role               String        @default("admin") // admin | viewer
  subscriptionPlan   String        @default("trial") // trial | monthly
  subscriptionStatus String        @default("pending") // active | pending | expired
  subscriptionEndsAt DateTime? 
  lineId             String?       @unique
  displayName        String?
  pictureUrl         String?
  bankName           String?
  bankAccount        String?
  bankAccountName    String?
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  payments           Payment[]
  activityLogs       ActivityLog[]

  // Affiliate System
  isAffiliate        Boolean       @default(false)
  referralCode       String        @default("")
  referredById       String?
  referredBy         User?         @relation("Referrals", fields: [referredById], references: [id])
  referees           User[]        @relation("Referrals")
  affiliateRate      Float         @default(0.35)

  commissions        AffiliateCommission[] @relation("ReferrerCommissions")
  referredCommissions AffiliateCommission[] @relation("ReferredCommissions")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // REGISTER, LOGIN, SUBMIT_PAYMENT, PAYMENT_APPROVED, PAYMENT_REJECTED
  details   String?  @db.Text // JSON string or extra info
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  slipUrl     String
  status      String   @default("pending") // pending | approved | rejected
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commissions AffiliateCommission[]
}

model AffiliateCommission {
  id         String   @id @default(uuid())
  referrerId String
  referrer   User     @relation("ReferrerCommissions", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String
  referred   User     @relation("ReferredCommissions", fields: [referredId], references: [id], onDelete: Cascade)
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount     Float
  status     String   @default("pending") // pending | approved | paid | cancelled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebhookEvent {
  id           String   @id @default(uuid())
  source       String   @default("tradingview")
  symbol       String
  timeframe    String
  rawPayload   String   @db.Text // Storing JSON string for raw TV payload (SQLite compatible string representation)
  receivedAt   DateTime @default(now())
  status       String   @default("pending") // pending | processed | rejected | error
  errorMessage String?  @db.Text

  @@index([receivedAt])
  @@index([source, status, symbol])
  @@index([symbol, source, status, receivedAt])
}

model Candle {
  id        String   @id @default(uuid())
  symbol    String
  timeframe String   // M15 | H1 | H4
  time      DateTime // The candle open timestamp
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, time])
}

model Zone {
  id            String   @id @default(uuid())
  symbol        String
  timeframe     String   // e.g., H1 | H4
  type          String   // SUPPORT | RESISTANCE | LIQUIDITY
  priceMin      Float
  priceMax      Float
  strength      Int      @default(1)
  touchCount    Int      @default(1)
  lastTouchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Signal {
  id              String       @id @default(uuid())
  symbol          String
  timeframe       String
  direction       String       // BUY | SELL | NO_TRADE
  entry           Float
  stopLoss        Float
  takeProfit1     Float
  takeProfit2     Float
  takeProfit3     Float?
  riskReward      Float
  confidence      Int          @default(0)
  status          String       @default("pending") // pending | active | win | loss | cancelled
  bias            String       @default("Wait")    // Buy | Sell | Wait
  entryZone       String?
  riskLevel       String?      // Low | Medium | High
  marketCondition String?
  result          String       @default("Pending") // Win | Loss | BE | Pending
  screenshotUrl   String?
  reason          String       @db.Text      // JSON string details of setup filters
  fakeoutScore    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paperTrades     PaperTrade[]

  @@index([createdAt])
  @@index([symbol, status, createdAt])
}

model PaperTrade {
  id                   String    @id @default(uuid())
  signalId             String?
  signal               Signal?   @relation(fields: [signalId], references: [id])
  symbol               String
  direction            String    // BUY | SELL
  entry                Float
  stopLoss             Float
  takeProfit1          Float
  takeProfit2          Float
  exitPrice            Float?
  result               String    @default("OPEN") // PLAN | OPEN | WIN | LOSS | BE | CANCELLED
  rrResult             Float     @default(0.0)    // Final R-multiple result
  openedAt             DateTime  @default(now())
  closedAt             DateTime?
  notes                String?   @db.Text
  screenshotBeforeUrl  String?
  screenshotAfterUrl   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([result])
  @@index([symbol, result, openedAt])
  @@index([openedAt])
  @@index([closedAt])
}
